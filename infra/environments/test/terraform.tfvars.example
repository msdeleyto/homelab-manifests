# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit secrets.

# Proxmox VE — test hypervisor running as a VM on this machine
# (created via infra/tooling/create-test-pve-vm or libvirt/qemu)
pve_endpoint     = "https://192.168.122.50:8006"
pve_username     = "terraform@pve"
pve_password     = "CHANGE_ME"
pve_ssh_user     = "root"
pve_node         = "pve-test"
pve_storage_pool = "local-lvm"
cpu_type         = "kvm64" # or "host" if host-passthrough is configured

# Talos image — can reuse the same image as prod (PVE won't re-download if already present)
talos_version      = "v1.9.0"
talos_schematic_id = "CHANGE_ME"
talos_image_url    = "https://factory.talos.dev/image/CHANGE_ME/v1.9.0/nocloud-amd64.raw.xz"

# Cluster
cluster_name = "homelab-test"

# For a single-node cluster the VIP is just the node's own IP
cluster_vip  = "192.168.10.60"
gateway      = "192.168.10.1"

# Absolute path to the root of this repository on the machine running Terraform
manifests_path = "/path/to/homelab-manifests"

# Single node — override only if you need different resources
# nodes = {
#   "talos-test-01" = { vmid = 201, ip = "192.168.10.60/24", controlplane = true, cpu_cores = 4, memory_mb = 8192, os_disk_gb = 64, data_disk_gb = 100 }
# }
