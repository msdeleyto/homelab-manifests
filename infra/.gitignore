# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform lock file (generated per-machine)
.terraform.lock.hcl

# Terraform working directory
.terraform/

# Variable files with secrets
*.tfvars
!*.tfvars.example

# Sensitive outputs
kubeconfig
talosconfig
*.kubeconfig
*.talosconfig

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
