#!/bin/bash

set -euo pipefail

# Verify requirements
verify_requirements() {
  error="0"

  if ! which kubectl 2>&1 > /dev/null; then
    echo "    [!] kubectl not detected!"
    error="1"
  fi

  if ! which helm 2>&1 > /dev/null; then
    echo "    [!] helm not detected!"
    error="1"
  fi

  if [[ "${error}" == "1" ]]; then
    exit 1
  fi
}

project_path="$(dirname $0)/.."

echo "[+] Verifying requirements..."
verify_requirements "${project_path}"
echo -e "    Everything ready!\\n"

echo "[+] Installing CRDs..."
"${project_path}"/manifests/crds/tooling/bootstrap
echo -e "    CRDs ready!\\n"

# Install CNI
echo "[1/4] Bootstraping CNI..."
"${project_path}"/manifests/network/tooling/bootstrap
echo -e "   CNI ready!\\n"

# Install ESO
echo "[2/3] Bootstraping ESO..."
"${project_path}"/manifests/external-secrets/tooling/bootstrap
echo -e "   ESO ready!\\n"

# Install ArgoCD
echo "[3/3] Bootstraping ArgoCD..."
"${project_path}"/manifests/devops-tools/tooling/bootstrap
echo -e "   Devops-tools ready!\\n"

echo "[+] Cluster services ready!"
