#!/bin/bash

set -euo pipefail

# Verify requirements
verify_requirements() {
  error="0"

  if ! which kubectl 2>&1 > /dev/null; then
    echo "    [!] kubectl not detected!"
    error="1"
  fi

  if ! which helm 2>&1 > /dev/null; then
    echo "    [!] helm not detected!"
    error="1"
  fi

  if [[ "${error}" == "1" ]]; then
    exit 1
  fi
}

vault_secrets="$1"

project_path="$(dirname $0)/.."

echo "[+] Verifying requirements..."
verify_requirements "${project_path}"
echo -e "    Everything ready!\\n"

echo "[+] Installing CRDs..."
"${project_path}"/manifests/crds/tooling/bootstrap
echo -e "    CRDs ready!\\n"

# Install CNI
echo "[1/5] Bootstraping CNI..."
"${project_path}"/manifests/network/tooling/bootstrap
echo -e "   CNI ready!\\n"

# Install storage
echo "[2/5] Bootstraping storage..."
"${project_path}"/manifests/longhorn-system/tooling/bootstrap
echo -e "   Storage ready!\\n"

# Install Vault
echo "[3/5] Bootstraping vault..."
"${project_path}"/manifests/vault/tooling/bootstrap "${vault_secrets}"
echo -e "   Vault ready!\\n"

# Install ESO
echo "[4/5] Bootstraping ESO..."
"${project_path}"/manifests/external-secrets/tooling/bootstrap
echo -e "   ESO ready!\\n"

# Install ArgoCD
echo "[5/5] Bootstraping ArgoCD..."
"${project_path}"/manifests/devops-tools/tooling/bootstrap
echo -e "   Devops-tools ready!\\n"

echo "[+] Cluster services ready!"
