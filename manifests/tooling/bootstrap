#!/bin/bash

set -euo pipefail

# Verify requirements
verify_requirements() {
  local error=0

  if ! which kubectl &>/dev/null; then
    echo "    [!] kubectl not found"
    error=1
  fi

  if ! which helm &>/dev/null; then
    echo "    [!] helm not found"
    error=1
  fi

  if ! which envsubst &>/dev/null; then
    echo "    [!] envsubst not found"
    error=1
  fi

  if ! which yq &>/dev/null; then
    echo "    [!] yq not found"
    error=1
  fi

  if ! kubectl kustomize --help &>/dev/null 2>&1; then
    echo "    [!] kubectl kustomize not available"
    error=1
  fi

  if [[ "${error}" == "1" ]]; then
    exit 1
  fi
}

project_path="$(cd "$(dirname "$0")/../.." && pwd)"
manifests_path="${project_path}/manifests"

echo "[+] Verifying requirements..."
verify_requirements
echo "    Everything ready!"

# Validate required variables
required_vars=(
  BITWARDEN_ACCESS_TOKEN
  INFRA_ENV
  INFRA_DOMAIN
  INFRA_LB_IP
  INFRA_HA_VIP
  INFRA_BITWARDEN_ORG_ID
  INFRA_BITWARDEN_PROJECT_ID
)
missing=()
for var in "${required_vars[@]}"; do
  if [[ -z "${!var:-}" ]]; then
    missing+=("$var")
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  echo ""
  echo "Error: missing required variables:"
  for var in "${missing[@]}"; do
    echo "  - ${var}"
  done
  exit 1
fi

# Step 1: Install CRDs
echo ""
echo "[1/4] Installing CRDs..."
kubectl apply --server-side --force-conflicts -k "${manifests_path}/crds" > /dev/null
echo "    CRDs ready!"

# Step 2: Install Cilium (CNI)
echo ""
echo "[2/4] Installing Cilium (CNI)..."

# Create namespace network and set pod security labels
kubectl apply -f "${manifests_path}/network/cilium/namespace.yaml"

cat "${manifests_path}/network/cilium/values.yaml" | envsubst '${INFRA_HA_VIP}' > /tmp/cilium-values.yaml

cilium_version="$(yq -r '.helmCharts[] | select(.name == "cilium") | .version' "${manifests_path}/network/cilium/kustomization.yaml")"
helm upgrade --install cilium oci://quay.io/cilium/charts/cilium --force-conflicts \
  --version "${cilium_version}" \
  --namespace network \
  --values /tmp/cilium-values.yaml > /dev/null

kubectl wait --namespace network \
  --for=create daemonset.apps/cilium-envoy \
  --timeout=300s

kubectl wait --namespace network \
  --for=condition=Ready pod \
  --selector=name=cilium-envoy \
  --timeout=300s

kubectl wait --namespace network \
  --for=create daemonset.apps/cilium \
  --timeout=300s

kubectl wait --namespace network \
  --for=condition=Ready pod \
  --selector=app.kubernetes.io/name=cilium-agent \
  --timeout=300s

echo "    Applying Cilium configuration..."
kubectl kustomize --enable-helm "${project_path}/cilium" | \
  envsubst '${INFRA_DOMAIN} ${INFRA_LB_IP} ${INFRA_HA_VIP}' | \
  kubectl apply --server-side --force-conflicts -f - > /dev/null
echo "    Cilium ready!"

# Step 3: Install External Secrets Operator
echo ""
echo "[3/4] Installing External Secrets Operator..."
kubectl create namespace external-secrets --dry-run=client -o yaml | kubectl apply -f -

# Create Bitwarden access token secret
echo "    Creating Bitwarden access token secret..."
kubectl create secret generic bitwarden-access-token \
  --namespace external-secrets \
  --from-literal=token="${BITWARDEN_ACCESS_TOKEN}" \
  --dry-run=client -o yaml | kubectl apply -f -

kubectl kustomize "${manifests_path}/external-secrets/external-secrets" --enable-helm | \
  kubectl apply --server-side --force-conflicts -f - > /dev/null

echo "    Waiting for ESO webhook to be ready..."
kubectl --namespace external-secrets wait --for condition=available deploy/external-secrets-webhook --timeout=120s > /dev/null
echo "    ESO ready!"

# Step 4: Install ArgoCD
echo ""
echo "[4/4] Installing ArgoCD..."
kubectl create namespace devops-tools --dry-run=client -o yaml | kubectl apply -f -
kubectl kustomize --enable-helm "${manifests_path}/devops-tools/argocd" | \
  envsubst '${INFRA_DOMAIN} ${INFRA_ENV}' | \
  kubectl apply --server-side --force-conflicts -f - > /dev/null
echo "    ArgoCD ready!"

echo ""
echo "[+] Bootstrap complete!"
echo ""
